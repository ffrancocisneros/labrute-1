// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../../prisma"
  previewFeatures = ["nativeDistinct", "relationJoins"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Lang {
  en
  fr
  de
  es
  ru
  pt
}

model User {
  id                            String                          @id @unique @db.Uuid
  lang                          Lang                            @default(en)
  name                          String                          @db.VarChar(255)
  admin                         Boolean                         @default(false)
  moderator                     Boolean                         @default(false)
  connexionToken                String                          @db.Uuid
  bruteLimit                    Int                             @default(10)
  gold                          Int                             @default(0)
  fightSpeed                    Int                             @default(2)
  backgroundMusic               Boolean                         @default(true)
  dinorpgDone                   DateTime?                       @db.Date
  ips                           String[]                        @default([])
  bannedAt                      DateTime?                       @db.Date
  banReason                     String?
  displayVersusPage             Boolean                         @default(true)
  displayOpponentDetails        Boolean                         @default(false)
  lastSeen                      DateTime                        @default(now()) @db.Date
  brutes                        Brute[]
  achievements                  Achievement[]
  reports                       BruteReport[]
  tournamentGolds               TournamentGold[]
  inventory                     InventoryItem[]
  favoriteFights                Fight[]                         @relation("FavoriteFights")
  following                     Brute[]                         @relation("Followers")
  notifications                 Notification[]
  reportsHandled                BruteReport[]                   @relation("BruteReportHandler")
  logs                          UserLog[]
  dailyObjectives               DailyObjective[]
  weeklyObjectives              WeeklyObjective[]
  permanentAchievements         PermanentAchievement[]
  missions                      Mission[]
  missionAchievements           MissionAchievement[]
  lastFightDate                 DateTime?                       @db.Date
  consecutiveDaysPlayed         Int                             @default(0)
  unlockedTitleIds              Int[]                           @default([])
  equippedTitleId               Int?
  bonusFightsCount              Int                             @default(0)
  bonusFightsDate               DateTime?                       @db.Date
  userBattlePassProgress        UserBattlePassProgress[]
  userBattlePassMissionProgress UserBattlePassMissionProgress[]
  userUnlockedCosmetics         UserUnlockedCosmetic[]
  usedSkills                    UserUsedSkill[]
}

enum UserLogType {
  CONNECT
  DISCONNECT
  GOLD_WIN
  GOLD_LOSS
  CREATE_BRUTE
  RENAME_BRUTE
  SACRIFICE_BRUTE
  BANNED
}

model UserLog {
  id      String      @id @unique @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  date    DateTime    @default(now()) @db.Timestamp()
  user    User        @relation(fields: [userId], references: [id])
  userId  String      @db.Uuid
  type    UserLogType
  brute   Brute?      @relation(fields: [bruteId], references: [id])
  bruteId String?     @db.Uuid
  gold    Int?
  oldName String?

  @@index([userId, date])
  @@index([bruteId])
}

enum DestinyChoiceSide {
  LEFT  @map("0")
  RIGHT @map("1")
}

enum Gender {
  male
  female
}

